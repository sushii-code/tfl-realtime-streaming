# Optional: without a key, the TfL API is called anonymously, which has a lower rate limit.
# Our producer calls the API about twice a minute, so anonymous access is fine.
# The real value is set only in the terminal. Never write your key in this file.
TFL_APP_KEY=

# Optional settings. Set them in the terminal to change them; these are the defaults.
# Used by the producer and the consumer: the address of Kafka, from a program running on the laptop
KAFKA_BOOTSTRAP_SERVER=localhost:9092
# Used by the producer and the consumer: the topic for tube line statuses
LINE_STATUS_TOPIC=line_status
# Used by the producer and the consumer: the topic for data that could not be processed
DEAD_LETTER_TOPIC=dead_letter
# Producer: how many seconds to leave between TfL API calls
POLL_INTERVAL_SECONDS=30
# Consumer: the consumer group to join
CONSUMER_GROUP_ID=line_status_landing
# Consumer and Snowflake loader: the folder for batch files, relative to the project's main folder
LANDING_DIR=data/landing/line_status
# Consumer: write a file after this many messages...
BATCH_SIZE=100
# Consumer: ...or after this many seconds, whichever comes first
BATCH_SECONDS=30
# Consumer: true means read everything available, save it, commit, then exit
CONSUMER_RUN_ONCE=false

# Required by the Snowflake loader. Set them in the terminal; never write real values in this file.
# Your Snowflake account identifier
SNOWFLAKE_ACCOUNT=
# The user the loader logs in as
SNOWFLAKE_USER=
# The role the loader uses
SNOWFLAKE_ROLE=
# The warehouse that runs the load
SNOWFLAKE_WAREHOUSE=
# The database holding the stage and table
SNOWFLAKE_DATABASE=
# The schema holding the stage and table
SNOWFLAKE_SCHEMA=
# The PATH to your private key file, relative to the project's main folder; never the key itself
SNOWFLAKE_PRIVATE_KEY_PATH=

# Required by dbt. Set them in the terminal; never write real values in this file.
# Your Snowflake account identifier
TFL_DBT_ACCOUNT=
# The user dbt logs in as
TFL_DBT_USER=
# The role dbt uses
TFL_DBT_ROLE=
# The warehouse that runs dbt's queries
TFL_DBT_WAREHOUSE=
# The database where dbt builds things
TFL_DBT_DATABASE=
# The start of the name of the schemas dbt creates
TFL_DBT_SCHEMA=
# The full PATH to your private key file; never the key itself
TFL_DBT_PRIVATE_KEY_PATH=

# Required by the dashboard. Set them in the terminal; never write real values in this file.
# Your Snowflake account identifier
TFL_APP_ACCOUNT=
# The user the dashboard logs in as
TFL_APP_USER=
# The read-only role the dashboard uses
TFL_APP_ROLE=
# The warehouse that runs the dashboard's queries
TFL_APP_WAREHOUSE=
# The PATH to your private key file, relative to the project's main folder; never the key itself
TFL_APP_PRIVATE_KEY_PATH=

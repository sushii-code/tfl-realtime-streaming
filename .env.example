# Optional: without a key, the TfL API is called anonymously, which has a lower rate limit.
# Our producer calls the API about twice a minute, so anonymous access is fine.
# The real value is set only in the terminal. Never write your key in this file.
TFL_APP_KEY=

# Optional producer settings. Set them in the terminal to change them; these are the defaults.
# The address of Kafka, from a program running on the laptop
KAFKA_BOOTSTRAP_SERVER=localhost:9092
# The topic for tube line statuses
LINE_STATUS_TOPIC=line_status
# The topic for data that could not be processed
DEAD_LETTER_TOPIC=dead_letter
# How many seconds to leave between TfL API calls
POLL_INTERVAL_SECONDS=30

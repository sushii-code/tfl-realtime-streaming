# --- Python ---
# Compiled Python files, created automatically when code runs
__pycache__/
*.py[cod]
# Packaging and build output
*.egg-info/
build/
dist/
# Test tool cache
.pytest_cache/

# --- Virtual environment ---
# Installed packages live here; anyone can recreate them from requirements.txt
.venv/
venv/

# --- Secrets ---
# Any .env file may hold real keys, so ignore them all
.env
.env.*
# ...except the example file, which holds no real values and is safe to share
!.env.example
# Private key files (Snowflake key-pair login uses these)
*.pem
*.p8
# The folder for the Snowflake key pair, made by snowflake/generate_keys.py
keys/

# --- Data ---
# Files written by the consumer must not go to GitHub (data/samples is still kept)
data/landing/

# --- dbt ---
# Generated by dbt on every run or install, so no need to save them
dbt/target/
dbt/logs/
dbt/dbt_packages/
# dbt's anonymous ID for this laptop, created next to profiles.yml
dbt/.user.yml
target/
dbt_packages/

# --- Airflow ---
# Log files written by Airflow while it runs
airflow/logs/

# --- General logs ---
# Any log file, in any folder (includes dbt's dbt.log)
*.log

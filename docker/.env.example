# Copy this file to docker/.env and fill in the values. docker/.env is ignored by git.
# Airflow's tasks read these. The private key file paths are already set in docker-compose.yml.

# The loader's Snowflake account identifier
SNOWFLAKE_ACCOUNT=
# The user the loader logs in as
SNOWFLAKE_USER=
# The role the loader uses
SNOWFLAKE_ROLE=
# The warehouse that runs the load
SNOWFLAKE_WAREHOUSE=
# The database holding the stage and table
SNOWFLAKE_DATABASE=
# The schema holding the stage and table
SNOWFLAKE_SCHEMA=

# dbt's Snowflake account identifier
TFL_DBT_ACCOUNT=
# The user dbt logs in as
TFL_DBT_USER=
# The role dbt uses
TFL_DBT_ROLE=
# The warehouse that runs dbt's queries
TFL_DBT_WAREHOUSE=
# The database where dbt builds things
TFL_DBT_DATABASE=
# The start of the name of the schemas dbt creates
TFL_DBT_SCHEMA=
